# Example environment for deploy/compose.yaml.
# Copy to deploy/.env (or .env next to compose.yaml) and fill the secrets.
# See deploy/docs/deployment.md for the full table and deploy/docs/architecture.md
# for runtime vs baked configuration.

# --- Identity: the single public origin that serves both the app and Kong ---
# This fork assumes the client and Kong share one origin behind a reverse proxy,
# so there are no cross-origin requests. read.conraaad.com is the reference deployment.
SITE_URL=https://read.example.com
API_EXTERNAL_URL=https://read.example.com
ADDITIONAL_REDIRECT_URLS=https://read.example.com/**
PUBLIC_APP_URL=https://read.example.com
PUBLIC_SUPABASE_URL=https://read.example.com

# Legacy fallback for local IP/port deployments without a reverse proxy.
# When PUBLIC_* above are set, this is unused. Upstream docker/.env.example uses it
# to derive SUPABASE_PUBLIC_URL as http://${HOST_IP}:${KONG_HTTP_PORT}.
HOST_IP=localhost

# --- Database & JWT ---
POSTGRES_PASSWORD=change-me-32-char-postgres-password-at-least-32-chars
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_HOST=db
JWT_SECRET=change-me-32-char-jwt-secret-at-least-32-chars
JWT_EXPIRY=3600
# HS256 JWTs signed with JWT_SECRET:
#   ANON_KEY payload: {"role":"anon"}
#   SERVICE_ROLE_KEY payload: {"role":"service_role"}
# Rotating JWT_SECRET invalidates both and requires rebuilding the Android APK.
ANON_KEY=change-me-anon-key-jwt-signed-with-jwt-secret
SERVICE_ROLE_KEY=change-me-service-role-key-jwt-signed-with-jwt-secret
KONG_HTTP_PORT=8000
PGRST_DB_SCHEMAS=public,graphql_public

# --- Client image ---
# The patched image published by .github/workflows/selfhost-image.yml.
# Update.py / the release workflow keeps the tag aligned with the upstream tag.
READEST_IMAGE=ghcr.io/conradsheeran/readest:latest

# --- Auth: signup gating ---
# The allowlist hook does the gating, not DISABLE_SIGNUP. See deployment.md.
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false

# Only needed when ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_SENDER_NAME=Readest

# --- Object storage: Cloudflare R2 via S3 API ---
# No MinIO. See deployment.md — forcePathStyle is already true in src/utils/s3.ts,
# so R2 is fine. A provider that requires virtual-hosted-style would need a patch.
OBJECT_STORAGE_TYPE=s3
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET_NAME=readest-files
S3_ACCESS_KEY_ID=change-me-r2-access-key-id
S3_SECRET_ACCESS_KEY=change-me-r2-secret-access-key

# --- Quotas: decoupled from plans via fixed values ---
# utils/access.ts prefers the fixed value over the per-plan table.
STORAGE_FIXED_QUOTA=1073741824
TRANSLATION_FIXED_QUOTA=50000

# --- Optional ---
# Where the reader loads CJK webfont bundles from. Empty falls back to Readest's
# CDN (https://storage.readest.com) which only sends CORS for readest.com origins.
FONT_BASE_URL=
# Self-hosted DeepLX proxy for translation. Patched by P6 — without these, the
# app calls the official DeepL endpoints directly.
DEEPLX_API_URL=
DEEPLX_API_TOKEN=
