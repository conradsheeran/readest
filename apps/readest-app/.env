PDFJS_BUILD_PATH=../../packages/foliate-js/node_modules/pdfjs-dist/legacy/build
PDFJS_FONTS_PATH=../../packages/foliate-js/node_modules/pdfjs-dist
PDFJS_STYLE_PATH=../../packages/foliate-js/vendor/pdfjs

# Upstream ships its own production credentials here, base64-obfuscated, and the
# lookups are `process.env['NEXT_PUBLIC_<X>'] || atob(<default>)` — an empty
# override is falsy and falls through to the default, so the defaults themselves
# have to go. See deploy/docs/patch-ledger.md (P5).
#
# Blank, not removed: `atob(undefined)` throws, `atob('')` returns ''.
NEXT_PUBLIC_DEFAULT_POSTHOG_URL_BASE64=""
NEXT_PUBLIC_DEFAULT_POSTHOG_KEY_BASE64=""

# Placeholders rather than blank: `utils/supabase.ts` calls `createClient` at
# module scope, and supabase-js validates the URL and rejects an empty key inside
# the constructor, so blanking these fails `next build` outright. The web image
# overrides them from runtime config, the Android build from `.env.local`.
# Decoded: https://placeholder.invalid / selfhost-placeholder-anon-key
NEXT_PUBLIC_DEFAULT_SUPABASE_URL_BASE64="aHR0cHM6Ly9wbGFjZWhvbGRlci5pbnZhbGlk"
NEXT_PUBLIC_DEFAULT_SUPABASE_KEY_BASE64="c2VsZmhvc3QtcGxhY2Vob2xkZXItYW5vbi1rZXk="

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_DEV_BASE64=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_BASE64=""
